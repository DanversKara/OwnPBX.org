# OwnPBX Portal - sample environment settings
# Copy this file to /etc/ai-pbx.env and fill in your own values.
# The real file must NEVER be added to git (it holds the secrets).
#   sudo cp .env.example /etc/ai-pbx.env
#   sudo chown root:asterisk /etc/ai-pbx.env
#   sudo chmod 640 /etc/ai-pbx.env

# --- Database (the application's runtime user: only SELECT/INSERT/UPDATE/DELETE) ---
DB_HOST=localhost
DB_NAME=asterisk
DB_USER=aipbx_portal
DB_PASS=change-me

# --- Migration user (DDL rights for Phinx/root only) ---
# In production, MIGRATOR_DB_USER / MIGRATOR_DB_PASS are isolated in /etc/ai-pbx-migrator.env
# (mode 0600 root:root) so the web runtime has no DDL privileges.
# MIGRATOR_DB_USER=aipbx_migrator
# MIGRATOR_DB_PASS=change-me

# --- Site identity ---
SITE_NAME=OwnPBX Portal
PORTAL_DOMAIN=example.com
TIMEZONE=Europe/Istanbul

# --- Asterisk AMI (Manager Interface) ---
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=aipbx-manager
AMI_PASS=change-me

# --- File/directory paths (the defaults are usually enough) ---
ASTERISK_PBX_DIR=/etc/asterisk/pbx
ASTERISK_CALL_SPOOL=/var/spool/asterisk/outgoing
FAX_STORAGE_PATH=/var/www/faxes
FAX_OUTGOING_SPOOL=/var/spool/asterisk/fax/outgoing
SOUNDS_CUSTOM_DIR=/var/lib/asterisk/sounds/custom
MOH_BASE_DIR=/var/lib/asterisk/moh
MONITOR_STORAGE_PATH=/var/spool/asterisk/monitor
PJSIP_DTLS_CERT=/etc/asterisk/keys/asterisk.pem
GS_BINARY=/usr/bin/gs
SYNC_QUEUE_LOGS_SCRIPT=/usr/local/bin/sync_queue_logs.php

# --- Mail (password reset / fax notification emails) ---
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=OwnPBX Portal

# --- WebRTC TURN (coturn) — when left empty, no TURN candidate is offered ---
TURN_HOST=
TURN_SECRET=
TURNS_PORT=443

# --- OpenBao vault (admin PIN tripwire) ---
# Three wrong admin PINs seal the vault (PUT /v1/sys/seal). OPENBAO_SEAL_TOKEN
# must be a seal-only token: its policy grants nothing but `update` on
# sys/seal, so it can seal but never read a secret or unseal. See
# docs/openbao-seal-token.md for the policy and the commands to create it.
# Leave OPENBAO_SEAL_TOKEN empty to disable the seal (the 3-strikes lockout
# still applies, but the vault is not sealed).
OPENBAO_ADDR=http://192.168.8.100:8200
OPENBAO_SEAL_TOKEN=
