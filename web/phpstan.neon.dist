# PHPStan static analysis: CI (.github/workflows/web-ci.yml) runs it on every push.
# Yerelde: vendor/bin/phpstan analyse
#
# phpstan-baseline.neon: the findings that existed when this configuration was
# added (2026-09-27). CI fails only on NEW errors; shrink the baseline over time
# (after fixing a finding: `vendor/bin/phpstan analyse --generate-baseline`).
includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - api
        - bin
        - modules
        - config.php
        - auth.php
        - index.php
    scanFiles:
        - config.php
        # The SMS plugin's classes, used by api/mobile/sms.php (loaded at run time from the plugin).
        - ../plugins/sms/lib/Provider.php
        - ../plugins/sms/lib/Media.php
        - ../plugins/sms/lib/Sms.php
        # The Billing plugin's classes, used through src/services/BillingBridge.php.
        - ../plugins/billing/lib/Stripe.php
        - ../plugins/billing/lib/Billing.php
        # The Reseller plugin's class, used through src/services/ResellerBridge.php.
        - ../plugins/reseller/lib/Reseller.php
        - ../plugins/ha-texts/lib/HaTexts.php
        - ../plugins/invites/lib/Invites.php
        - ../plugins/launcher/lib/LauncherFeed.php
        - ../plugins/billing/lib/Store.php
    tmpDir: .phpstan-cache
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # The define() constants of config.php are read from /etc/ai-pbx.env at
        # run time; PHPStan cannot see them.
        - identifier: constant.notFound
        # BillingBridge checks a method exists before calling it, because the Billing class
        # loaded at run time can be an OLDER copy installed under /var/lib/aipbx/plugins,
        # which shadows the bundled one PHPStan reads here. The guard turns an out-of-date
        # plugin into a no-op instead of a fatal error, so it stays.
        -
            identifier: function.alreadyNarrowedType
            path: src/services/BillingBridge.php
